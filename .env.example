# ==============================================================================
# Diamond ERP - Backend Environment Variables
# ==============================================================================

# Application
APP_NAME="Diamond Manufacturing & ERP API"
ENVIRONMENT=development
DEBUG=True
API_V1_STR="/api/v1"

# Database Connection
# Local / IaaS VM:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diamond_erp_db
# For Azure PaaS:
# DATABASE_URL=postgresql://diamondadmin:YourPassword@your-server.postgres.database.azure.com:5432/diamond_erp_db?sslmode=require

# Security & JWT
# Generate a secure key in production: openssl rand -hex 32
SECRET_KEY=diamond_secret_super_key_2026_change_in_production_99a8b7c6
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480  # 8 hours

# CORS (Frontend Origins)
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

